# syntax=docker/dockerfile:1.7

# Exact parent images used by the 26-27 July 2026 study.
ARG BASE_IMAGE=voipmonitor/vllm@sha256:10261c7d65101c8aba2ce1fb59eabe73aff9d35eca5043b330cc0ce76d3c98d0
ARG EXL3_ARTIFACT_IMAGE=verdictai/glm52-exl3-sparkinfer@sha256:2bb9e804a283d1da3b7e3425ff87375121285141d0d0a40d3dc09d41bf881a10

# Named context sparkinfer-src:
# e603f74bb67d0fce547336f1fb73c3c23e8f1887 plus PR #49 head
# d4438d490691f79022fdfc8149e1c5f161d15445.
FROM ${BASE_IMAGE} AS sparkinfer-builder
WORKDIR /tmp/sparkinfer
COPY --from=sparkinfer-src . .
RUN /opt/venv/bin/python -m pip wheel \
      --no-deps \
      --no-build-isolation \
      --wheel-dir /tmp/dist \
      .

FROM ${EXL3_ARTIFACT_IMAGE} AS exl3-artifacts

FROM ${BASE_IMAGE}

LABEL org.opencontainers.image.title="GLM-5.2 EXL3 Trellis on topology-calibrated Gilded Gnosis v20" \
      org.opencontainers.image.description="Issue 33 vLLM 0c79e41 + SparkInfer e603f74 with EXL3 PR 139/49 source layers" \
      ai.verdict.base="voipmonitor/vllm@sha256:10261c7d65101c8aba2ce1fb59eabe73aff9d35eca5043b330cc0ce76d3c98d0" \
      ai.verdict.vllm.exl3="local-inference-lab/vllm#139@26c4bfdd3ff2be0433e6fe07e0c3be535f5bb318 merged onto 0c79e41db41f250ccdfc4be92d171960a5787f73" \
      ai.verdict.sparkinfer.exl3="local-inference-lab/sparkinfer#49@d4438d490691f79022fdfc8149e1c5f161d15445 merged onto e603f74bb67d0fce547336f1fb73c3c23e8f1887" \
      local-inference.exl3.vllm.commit="26c4bfdd3ff2be0433e6fe07e0c3be535f5bb318" \
      local-inference.exl3.sparkinfer.commit="d4438d490691f79022fdfc8149e1c5f161d15445" \
      local-inference.cache.fingerprint="vllm0c79e41-exl326c4bfd-sie603f74-exl3d4438d4"

COPY --from=sparkinfer-builder /tmp/dist/sparkinfer-1.0.1-py3-none-any.whl /tmp/sparkinfer-1.0.1-py3-none-any.whl
RUN /opt/venv/bin/pip install --no-deps --force-reinstall \
      /tmp/sparkinfer-1.0.1-py3-none-any.whl \
    && rm /tmp/sparkinfer-1.0.1-py3-none-any.whl

# Named context vllm-src:
# 0c79e41db41f250ccdfc4be92d171960a5787f73 plus PR #139 head
# 26c4bfdd3ff2be0433e6fe07e0c3be535f5bb318.
COPY --from=vllm-src vllm/config/model.py /opt/venv/lib/python3.12/site-packages/vllm/config/model.py
COPY --from=vllm-src vllm/model_executor/layers/fused_moe/routed_experts.py /opt/venv/lib/python3.12/site-packages/vllm/model_executor/layers/fused_moe/routed_experts.py
COPY --from=vllm-src vllm/model_executor/layers/quantization/__init__.py /opt/venv/lib/python3.12/site-packages/vllm/model_executor/layers/quantization/__init__.py
COPY --from=vllm-src vllm/model_executor/layers/quantization/exl3.py /opt/venv/lib/python3.12/site-packages/vllm/model_executor/layers/quantization/exl3.py
COPY --from=vllm-src vllm/model_executor/models/deepseek_mtp.py /opt/venv/lib/python3.12/site-packages/vllm/model_executor/models/deepseek_mtp.py
COPY --from=vllm-src vllm/model_executor/models/deepseek_v2.py /opt/venv/lib/python3.12/site-packages/vllm/model_executor/models/deepseek_v2.py
COPY --from=vllm-src vllm/model_executor/models/glm4_moe.py /opt/venv/lib/python3.12/site-packages/vllm/model_executor/models/glm4_moe.py
COPY --from=vllm-src vllm/model_executor/models/utils.py /opt/venv/lib/python3.12/site-packages/vllm/model_executor/models/utils.py
COPY --from=vllm-src vllm/models/deepseek_v32/nvidia/attention.py /opt/venv/lib/python3.12/site-packages/vllm/models/deepseek_v32/nvidia/attention.py
COPY --from=vllm-src vllm/v1/attention/backends/mla/indexer.py /opt/venv/lib/python3.12/site-packages/vllm/v1/attention/backends/mla/indexer.py
COPY --from=vllm-src vllm/v1/core/sched/scheduler.py /opt/venv/lib/python3.12/site-packages/vllm/v1/core/sched/scheduler.py
COPY --from=vllm-src vllm/v1/structured_output/__init__.py /opt/venv/lib/python3.12/site-packages/vllm/v1/structured_output/__init__.py

RUN /opt/venv/bin/python -m py_compile \
      /opt/venv/lib/python3.12/site-packages/vllm/config/model.py \
      /opt/venv/lib/python3.12/site-packages/vllm/model_executor/layers/fused_moe/routed_experts.py \
      /opt/venv/lib/python3.12/site-packages/vllm/model_executor/layers/quantization/__init__.py \
      /opt/venv/lib/python3.12/site-packages/vllm/model_executor/layers/quantization/exl3.py \
      /opt/venv/lib/python3.12/site-packages/vllm/model_executor/models/deepseek_mtp.py \
      /opt/venv/lib/python3.12/site-packages/vllm/model_executor/models/deepseek_v2.py \
      /opt/venv/lib/python3.12/site-packages/vllm/model_executor/models/glm4_moe.py \
      /opt/venv/lib/python3.12/site-packages/vllm/model_executor/models/utils.py \
      /opt/venv/lib/python3.12/site-packages/vllm/models/deepseek_v32/nvidia/attention.py \
      /opt/venv/lib/python3.12/site-packages/vllm/v1/attention/backends/mla/indexer.py \
      /opt/venv/lib/python3.12/site-packages/vllm/v1/core/sched/scheduler.py \
      /opt/venv/lib/python3.12/site-packages/vllm/v1/structured_output/__init__.py

RUN install -d /opt/glm52/lib /opt/glm52/kv-scale
COPY --from=exl3-artifacts /opt/glm52/lib/exllamav3_ext.cpython-312-x86_64-linux-gnu.so /opt/glm52/lib/exllamav3_ext.cpython-312-x86_64-linux-gnu.so
COPY --from=exl3-artifacts /opt/glm52/lib/libexl3_torch212_compat.so /opt/glm52/lib/libexl3_torch212_compat.so
COPY --from=exl3-artifacts /opt/glm52/kv-scale/glm52_nvfp4_mla_outer_scales.json /opt/glm52/kv-scale/glm52_nvfp4_mla_outer_scales.json

ENV LOCAL_INFERENCE_CACHE_FINGERPRINT=vllm0c79e41-exl326c4bfd-sie603f74-exl3d4438d4 \
    XDG_CACHE_HOME=/cache/jit/vllm0c79e41-exl326c4bfd-sie603f74-exl3d4438d4 \
    VLLM_CACHE_ROOT=/cache/jit/vllm0c79e41-exl326c4bfd-sie603f74-exl3d4438d4/vllm \
    VLLM_CACHE_DIR=/cache/jit/vllm0c79e41-exl326c4bfd-sie603f74-exl3d4438d4/vllm \
    TRITON_CACHE_DIR=/cache/jit/vllm0c79e41-exl326c4bfd-sie603f74-exl3d4438d4/triton \
    TORCHINDUCTOR_CACHE_DIR=/cache/jit/vllm0c79e41-exl326c4bfd-sie603f74-exl3d4438d4/torchinductor \
    TORCH_EXTENSIONS_DIR=/cache/jit/vllm0c79e41-exl326c4bfd-sie603f74-exl3d4438d4/torch_extensions \
    FLASHINFER_WORKSPACE_BASE=/cache/jit/vllm0c79e41-exl326c4bfd-sie603f74-exl3d4438d4/flashinfer \
    VLLM_EXL3_EXT_PATH=/opt/glm52/lib \
    VLLM_EXL3_ABI_SHIM=/opt/glm52/lib/libexl3_torch212_compat.so \
    VLLM_NVFP4_MLA_SCALES_FILE=/opt/glm52/kv-scale/glm52_nvfp4_mla_outer_scales.json
