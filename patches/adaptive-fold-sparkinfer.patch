+@dataclass(frozen=True)
+class _TwoLevelFoldPlan:
+    slices: tuple[tuple[int, int], ...] = ()
+    candidate_nbytes: int = 0
+
+
+def _plan_two_level_fold(
+    *,
+    q_rows: int,
+    topk: int,
+    page_size: int,
+    page_table_width: int,
+    supertile_pages: int,
+    num_chunks: int,
+    output_physical_slots: bool,
+) -> _TwoLevelFoldPlan:
+    fold_mode = os.getenv("SPARKINFER_INDEXER_TWO_LEVEL_FOLD", "auto").strip().lower()
+    disabled_modes = {"0", "false", "off", "no"}
+    forced_modes = {"1", "true", "on", "yes"}
+    if fold_mode not in {"auto", *disabled_modes, *forced_modes}:
+        raise ValueError(
+            "SPARKINFER_INDEXER_TWO_LEVEL_FOLD must be auto, 0, or 1 "
+            f"(got {fold_mode!r})"
+        )
+
+    raw_limit_mib = os.getenv("SPARKINFER_INDEXER_TWO_LEVEL_FOLD_MAX_MIB", "256")
+    try:
+        limit_mib = int(raw_limit_mib)
+    except ValueError as exc:
+        raise ValueError(
+            "SPARKINFER_INDEXER_TWO_LEVEL_FOLD_MAX_MIB must be a non-negative "
+            f"integer (got {raw_limit_mib!r})"
+        ) from exc
+    if limit_mib < 0:
+        raise ValueError(
+            "SPARKINFER_INDEXER_TWO_LEVEL_FOLD_MAX_MIB must be a non-negative "
+            f"integer (got {raw_limit_mib!r})"
+        )
+
+    width_tokens = page_table_width * page_size
+    if (
+        output_physical_slots
+        or width_tokens < 2 * _TWO_LEVEL_SLICE_TOKENS
+        or fold_mode in disabled_modes
+    ):
+        return _TwoLevelFoldPlan()
+
+    slice_tokens = _TWO_LEVEL_SLICE_TOKENS
+    min_slice = -(-width_tokens // _TWO_LEVEL_MAX_SLICES)
+    if min_slice > slice_tokens:
+        slice_tokens = -(-min_slice // page_size) * page_size
+
+    slices: list[tuple[int, int]] = []
+    total_slices = 0
+    for chunk_idx in range(num_chunks):
+        chunk_pages = (
+            min((chunk_idx + 1) * supertile_pages, page_table_width)
+            - chunk_idx * supertile_pages
+        )
+        chunk_tokens = chunk_pages * page_size
+        chunk_slices = max(1, -(-chunk_tokens // slice_tokens))
+        slices.append((chunk_slices, total_slices))
+        total_slices += chunk_slices
+
+    candidate_nbytes = q_rows * total_slices * topk * 8 + q_rows * 4
+    if fold_mode == "auto" and candidate_nbytes > limit_mib * 1024 * 1024:
+        return _TwoLevelFoldPlan(candidate_nbytes=candidate_nbytes)
+    return _TwoLevelFoldPlan(tuple(slices), candidate_nbytes)
+
+
